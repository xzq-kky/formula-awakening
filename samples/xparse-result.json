489],"row":3,"row_span":1,"text":"$e^{i\\t\\theta}=\\cos\\theta+i\\sin\\theta$"},{"cell_id":"9e903782bc966ecfc2dfd2c9704f27eeeadcf61b109a693404fc5695473be4e2","col":3,"col_span":1,"content_type":"text","coordinates":[0.698907,0.143791,0.920942,0.143791,0.920942,0.19489,0.698907,0.19489],"row":3,"row_span":1,"text":"$\\theta \\in\\mathbb{R}$"},{"cell_id":"5acf6ba8bd691507b56ba8753a7f78b9e5e1bf0b58d84a5dcf1e39a79050f680","col":1,"col_span":1,"content_type":"text","coordinates":[0.075694,0.19489,0.20185,0.19489,0.20185,0.24896,0.075694,0.24896],"row":4,"row_span":1,"text":"斯特林公式"},{"cell_id":"c4bc282335c33a6389acba09de0c1c87ed436aa40f8fe2e5f51b50d7ffae394c","col":2,"col_span":1,"content_type":"text","coordinates":[0.20185,0.19489,0.698907,0.19489,0.698907,0.24896,0.20185,0.24896],"row":4,"row_span":1,"text":"$n! \\approx \\sqrt{2\\pi n}\\left(\\frac{n}{e}\\right)^{n}$"},{"cell_id":"b722703e3bcd99bc2c29662b84a2c3db21665126903954b4dfc4c27fc5c9b3c6","col":3,"col_span":1,"content_type":"text","coordinates":[0.698907,0.19489,0.920942,0.19489,0.920942,0.24896,0.698907,0.24896],"row":4,"row_span":1,"text":"$n \\to \\infty$"}],"cols":3,"rows":4},"text":"\u003ctable border=\"1\" \u003e\u003ctr\u003e\n\u003ctd\u003e麦克劳林级数\u003c/td\u003e\n\u003ctd\u003e\u0026#36;e^{x}=\\sum\\limits{n=0}^{\\infty}\\frac{x^{n}}{n!}\u0026#36;\u003c/td\u003e\n\u003ctd\u003e\u0026#36;|x|\u0026lt;\\infty\u0026#36;\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\n\u003ctd\u003e高斯型函数\u003c/td\u003e\n\u003ctd\u003e\u0026#36;g(x)=e^{-x^{2}}\u0026#36;\u003c/td\u003e\n\u003ctd\u003e\u0026#36;x \\in \\mathbb{R}\u0026#36;\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\n\u003ctd\u003e欧拉公式\u003c/td\u003e\n\u003ctd\u003e\u0026#36;e^{i\\t\\theta}=\\cos\\theta+i\\sin\\theta\u0026#36;\u003c/td\u003e\n\u003ctd\u003e\u0026#36;\\theta \\in\u003cbr\u003e\\mathbb{R}\u0026#36;\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\n\u003ctd\u003e斯特林公式\u003c/td\u003e\n\u003ctd\u003e\u0026#36;n! \\approx \\sqrt{2\\pi n}\\left(\\frac{n}\u003cbr\u003e{e}\\right)^{n}\u0026#36;\u003c/td\u003e\n\u003ctd\u003e\u0026#36;n \\to \\infty\u0026#36;\u003c/td\u003e\n\u003c/tr\u003e\u003c/table\u003e","type":"Table"},{"coordinates":[0.369218,0.278075,0.631623,0.278075,0.631623,0.288176,0.369218,0.288176],"element_id":"f521a3196fc6a4e345efbd669edf12cfbf404e4b7069c4117992fff88950f6ba","metadata":{"category_depth":-1,"data_source":{"record_locator":{"protocol":"file","remote_file_path":"temp/高等数学-期中试卷.pdf"},"url":"file://temp/高等数学-期中试卷.pdf"},"is_continuation":false,"parent_id":"83f5015b4cea4efc3c33d7852b1afe53afbcedb8430f071a53ec428d2c5d5702"},"page_number":2,"text":"公式觉醒工作台·真实调用测试样本","type":"Footer"}],"file_id":"a49d00693a6d42f29cf0e3b8ee01c114","job_id":"cdaa643783fb4bccbfda0fd3a9cafd68","markdown":"# 高等数学（上）期中试卷\n\n东莞理工学院·2026-2027 学年第一学期\n\n专业班级：\n\n姓名：\n\n学号：\n\n得分：\n\n## 一、单项选择题（每小题4分，共20分）\n\n1．设函数\u0026#36;f(x)=x^{2}+1\u0026#36;，则其导函数＄f'(x)＄为（）\n\nA. \u0026#36;2x\u0026#36;\n\nB.\u0026#36;x^{2}\u0026#36;\n\nC. \u0026#36;2x+1\u0026#36;\n\nD. \u0026#36;\\dfrac{x^{3}}{3}\u0026#36;\n\n2．下列极限中，正确的是（）\n\nA. \u0026#36;\\lim\\limits{x \\to 0}\\dfrac{\\sin x}{x}=0\u0026#36;\n\nB. \u0026#36;\\lim\\limits{x \\to\n\n0}\\dfrac{\\sin x}{x}=1\u0026#36;\n\nC. \u0026#36;\\lim\\limits{x \\to \\infty}\\left(1+\\dfrac{1}\n\n{x}\\right)^{x}=1\u0026#36;\n\nD.\u0026#36;\\lim\\limits{x\\to0}\\dfrac{\\mathrm{e}^{x}-1}{x}=0\u0026#36;\n\n3．设\u0026#36;z=x^{2}y+\\sin(xy)\u0026#36;，则\u0026#36;\\dfrac{\\partial z}{\\partialx}\u0026#36;等于（）\n\nA. \u0026#36;2xy+y\\cos(xy)\u0026#36;\n\nB. \u0026#36;x^{2}+x\\cos(xy)\u0026#36;\n\nC. \u0026#36;2xy+\\cos(xy)\u0026#36;\n\nD.\n\n\u0026#36;x^{2}y\\cos(xy)\u0026#36;\n\n## 二、计算题（每小题10分，共40分）\n\n4．计算定积分：\n\n\u0026#36;\u0026#36;\\int{0}^{1}\\frac{1}{1+x^{2}}\\,\\mathrm{d}x=\\frac{\\pi}{4}\u0026#36;\u0026#36;\n\n5．计算下列二重积分：\n\n\u0026#36;\u0026#36;\\iint{D} xy \\,\\mathrm{d}x\\mathrm{d}y,\\quad D=\\left\\{(x,y)\\nmid 0\\le x\\le 1,\\ 0\\le y\\le x\\right\\}\u0026#36;\u0026#36;\n\n6．求微分方程的通解：\n\n\u0026#36;\u0026#36;\\frac{\\mathrm{d}y}{\\mathrm{d}x}+2y=3\\mathrm{e}^{-x}\u0026#36;\u0026#36;\n\n### 7．将函数展开为幂级数：\n\n\u0026#36;\u0026#36;f(x)=\\frac{1}{1+x}=\\sum_{n=0}^{\\infty}(-1)^{n}x^{n},\\quad |x|\u0026lt;1\u0026#36;\u0026#36;\n\n## 三、证明题（10分）\n\n8．证明：若函数＄f(x)＄在＄[a,b]\u0026#36; 上连续，且\u0026#36;f(a)f(b)\u0026lt;0\u0026#36;,，则存在\u0026#36;\\xi\\in（a,b)\u0026#36;，使得\u0026#36;f(\\xi)=0\u0026#36;\n\n四、附：常用公式对照表\n\n\u003ctable border=\"1\" \u003e\u003ctr\u003e\n\u003ctd\u003e名称\u003c/td\u003e\n\u003ctd\u003e表达式\u003c/td\u003e\n\u003ctd\u003e条件\u003c/td\u003e\n\u003c/tr\u003e\u003c/table\u003e\n\n\u003ctable border=\"1\" \u003e\u003ctr\u003e\n\u003ctd\u003e麦克劳林级数\u003c/td\u003e\n\u003ctd\u003e\u0026#36;e^{x}=\\sum\\limits{n=0}^{\\infty}\\frac{x^{n}}{n!}\u0026#36;\u003c/td\u003e\n\u003ctd\u003e\u0026#36;|x|\u0026lt;\\infty\u0026#36;\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\n\u003ctd\u003e高斯型函数\u003c/td\u003e\n\u003ctd\u003e\u0026#36;g(x)=e^{-x^{2}}\u0026#36;\u003c/td\u003e\n\u003ctd\u003e\u0026#36;x \\in \\mathbb{R}\u0026#36;\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\n\u003ctd\u003e欧拉公式\u003c/td\u003e\n\u003ctd\u003e\u0026#36;e^{i\\t\\theta}=\\cos\\theta+i\\sin\\theta\u0026#36;\u003c/td\u003e\n\u003ctd\u003e\u0026#36;\\theta \\in\u003cbr\u003e\\mathbb{R}\u0026#36;\u003c/td\u003e\n\u003c/tr\u003e\u003ctr\u003e\n\u003ctd\u003e斯特林公式\u003c/td\u003e\n\u003ctd\u003e\u0026#36;n! \\approx \\sqrt{2\\pi n}\\left(\\frac{n}\u003cbr\u003e{e}\\right)^{n}\u0026#36;\u003c/td\u003e\n\u003ctd\u003e\u0026#36;n \\to \\infty\u0026#36;\u003c/td\u003e\n\u003c/tr\u003e\u003c/table\u003e\n\n\u003c!-- 公式觉醒工作台·真实调用测试样本 --\u003e\n\n","metadata":{"data_source":{"record_locator":{"protocol":"file","remote_file_path":"temp/高等数学-期中试卷.pdf"},"url":"file://temp/高等数学-期中试卷.pdf"},"filename":"高等数学-期中试卷.pdf","filetype":"application/pdf","page_count":2},"pages":[{"angle":0,"dpi":144,"element_ids":["0cb818a22b60062e1bb4c10755c90eca998c85392885228a7ae94b1d33e049d4","4b1b4275cb4f2b0e6ee4f3d6925de130ebc23aa032